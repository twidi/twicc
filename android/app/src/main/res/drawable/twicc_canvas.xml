<?xml version="1.0" encoding="utf-8"?>
<!-- The TwiCC page canvas: a flat base and two soft radial auras (surfaces.css). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/twicc_canvas" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="90%p"
                android:startColor="@color/twicc_aura_start"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1"
                android:centerY="1"
                android:gradientRadius="80%p"
                android:startColor="@color/twicc_aura_end"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
